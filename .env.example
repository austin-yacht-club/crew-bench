# Crew Bench environment template.
# Copy this file to .env and fill in every required value before starting a
# stack, or generate values with:
#   ./scripts/generate_secrets.sh            # shared .env
#   ./scripts/generate_secrets.sh .env.dev   # debug stack only
#   ./scripts/generate_secrets.sh .env.prod  # production stack only
#
# ./scripts/compose.sh <dev|prod> uses .env.<env> when it exists and falls back
# to .env, so separate files give the two stacks independent credentials.
#
# Never commit these files. Compose interpolates these variables and will
# refuse to start if required secrets are missing or empty.

# --- PostgreSQL (required) ---
POSTGRES_USER=crewbench
POSTGRES_DB=crewbench
POSTGRES_PASSWORD=

# --- Backend (required) ---
# SECRET_KEY must be at least 32 characters. Used to sign JWTs.
SECRET_KEY=
# Initial admin login. The admin must change this password on first login.
ADMIN_EMAIL=admin@crewbench.app
# ADMIN_PASSWORD must be at least 12 characters. Do not use admin123 or other defaults.
ADMIN_PASSWORD=

# --- Optional ---
# LOG_LEVEL=INFO
# PUBLIC_URL=http://localhost:3333
# ROOT_PATH=/api
# CORS_ORIGINS=
# RECAPTCHA_SECRET_KEY=
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# Set LOG_FILE under /var/log/crewbench so logs land in the named volume.
# LOG_FILE=/var/log/crewbench/backend.log

# --- Per-stack overrides (optional) ---
# Production stack (docker-compose.prod.yml). Defaults shown.
# PROD_FRONTEND_PORT=3333
# PROD_BACKEND_PORT=8000
# PROD_DB_PORT=5432
# PROD_POSTGRES_DB=crewbench

# Debug stack (docker-compose.dev.yml). Defaults shown.
# DEV_FRONTEND_PORT=3334
# DEV_BACKEND_PORT=8001
# DEV_DB_PORT=5433
# DEV_POSTGRES_DB=crewbench_dev
# DEV_LOG_LEVEL=DEBUG
